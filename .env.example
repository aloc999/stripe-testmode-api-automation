# Copy to .env — never commit the real file.
# Dashboard → Developers → API keys → Secret key (Test mode).
# Must start with sk_test_. Live keys (sk_live_) are rejected by the client.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_TIMEOUT_SECONDS=10
STRIPE_MAX_RESPONSE_MS=1000

# Invalid-key probe always hits the real Stripe API so 401 is authentic.
STRIPE_AUTH_PROBE_URL=https://api.stripe.com/v1/balance
STRIPE_INVALID_KEY=sk_test_invalid_key_for_negative_tests
